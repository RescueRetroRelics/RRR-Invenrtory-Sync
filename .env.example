# Copy this file to .env and fill it in. .env is git-ignored.

# --- eBay (Production keyset) ---
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_DEV_ID=
EBAY_RUNAME=
# Optional: space-separated OAuth scopes. Defaults cover listings, inventory and orders.
# EBAY_SCOPES=
# Optional: supply a refresh token directly (e.g. from a CI secret) instead of .secrets/ebay_tokens.json
# EBAY_REFRESH_TOKEN=

# --- Shopify ---
SHOPIFY_STORE_DOMAIN=19kvj1-nb.myshopify.com
# Option A: a Dev Dashboard app's credentials (client credentials grant, token auto-renews every 24h)
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Option B: an existing admin-created custom app's static token (shpat_...)
SHOPIFY_ADMIN_TOKEN=
# Location to sync against (only one location on the store right now: 13252 Leech Dr)
SHOPIFY_LOCATION_ID=gid://shopify/Location/111648637224
SHOPIFY_API_VERSION=2026-07
