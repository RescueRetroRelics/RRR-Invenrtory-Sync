{%- comment -%}
  The whole stylesheet is inlined (about 11 KB). One less request = faster first paint on phones.
  Colors come from Theme settings > Colors.
{%- endcomment -%}
<style>
:root{
  --bg:{{ settings.color_bg }};--paper:{{ settings.color_paper }};--ink:{{ settings.color_ink }};--muted:{{ settings.color_muted }};
  --brand:{{ settings.color_brand }};--accent:{{ settings.color_accent }};--teal:{{ settings.color_teal }};--sun:{{ settings.color_sun }};--pink:{{ settings.color_pink }};
  --btn:{{ settings.color_button }};--btn-ink:{{ settings.color_button_text }};--line:{{ settings.color_line }};
  --radius:{{ settings.radius }}px;--w:{{ settings.page_width }}px;
  --font-body:system-ui,-apple-system,"Segoe UI",Roboto,"Helvetica Neue",Arial,sans-serif;
  --font-head:ui-rounded,"SF Pro Rounded","Arial Rounded MT Bold","Trebuchet MS",system-ui,sans-serif;
}
*,*::before,*::after{box-sizing:border-box}
html{-webkit-text-size-adjust:100%;scroll-behavior:smooth}
body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.55 var(--font-body);overflow-wrap:break-word}
img,svg{max-width:100%;height:auto;display:block}
a{color:inherit}
h1,h2,h3,h4{font-family:var(--font-head);line-height:1.15;margin:0 0 .5em;letter-spacing:-.01em}
h1{font-size:clamp(1.8rem,5vw,2.8rem)}h2{font-size:clamp(1.45rem,3.6vw,2.1rem)}h3{font-size:1.1rem}
p{margin:0 0 1em}
button,input,select,textarea{font:inherit;color:inherit}
:focus-visible{outline:3px solid var(--teal);outline-offset:2px}
.visually-hidden{position:absolute!important;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
.skip-link{position:absolute;left:-999px;top:0;background:var(--paper);padding:.6rem 1rem;z-index:99}
.skip-link:focus{left:1rem}
.page-width{max-width:var(--w);margin:0 auto;padding:0 1rem}
.section{padding:2.5rem 0}
.section--tint{background:var(--paper)}
.center{text-align:center}
.rte img{height:auto;border-radius:var(--radius)}
.rte a{color:var(--teal)}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:.4rem;min-height:48px;padding:.7rem 1.4rem;border:2px solid var(--btn);border-radius:999px;background:var(--btn);color:var(--btn-ink);font-weight:700;text-decoration:none;cursor:pointer;transition:transform .15s}
.btn:hover{transform:translateY(-1px)}
.btn--ghost{background:transparent;color:var(--btn)}
.btn--block{width:100%}
.btn[disabled]{opacity:.55;cursor:not-allowed;transform:none}
.field{display:block;width:100%;min-height:44px;padding:.55rem .8rem;border:1px solid var(--line);border-radius:calc(var(--radius) / 2);background:#fff}
.placeholder{background:var(--line);fill:var(--muted);width:100%;height:100%}
/* Announcement */
.announce{background:var(--brand);color:#fff;text-align:center;font-size:.9rem;padding:.5rem 1rem}
.announce a{color:#fff}
/* Header + mega menu */
.header{position:sticky;top:0;z-index:20;background:var(--bg);border-bottom:3px solid var(--sun)}
.header__bar{display:flex;align-items:center;gap:.75rem;min-height:64px}
.header__logo{margin:0;font-size:1.3rem;font-family:var(--font-head);flex:1}
.header__logo a{text-decoration:none;display:inline-block}
.header__icons{display:flex;gap:.25rem;align-items:center}
.icon-btn{display:inline-flex;align-items:center;justify-content:center;min-width:44px;min-height:44px;border:0;background:none;cursor:pointer;text-decoration:none;position:relative;border-radius:999px}
.icon-btn svg{width:24px;height:24px}
.cart-count{position:absolute;top:2px;right:0;background:var(--accent);color:#fff;font-size:.7rem;font-weight:700;border-radius:999px;min-width:18px;height:18px;line-height:18px;text-align:center;padding:0 4px}
.nav{display:none}
.nav[data-open]{display:block;position:absolute;left:0;right:0;top:100%;background:var(--bg);max-height:calc(100vh - 100px);overflow:auto;border-bottom:3px solid var(--sun);padding:.5rem 1rem 1.5rem}
.nav ul{list-style:none;margin:0;padding:0}
.nav__top>li{border-bottom:1px solid var(--line)}
.nav__top>li>a,.nav__top summary{display:flex;justify-content:space-between;align-items:center;min-height:48px;font-weight:700;text-decoration:none;cursor:pointer;list-style:none}
.nav summary::-webkit-details-marker{display:none}
.nav summary::after{content:"+";font-size:1.3rem;color:var(--accent)}
.nav details[open]>summary::after{content:"\2212"}
.mega{padding:0 0 1rem}
.mega__cols{display:grid;gap:1rem}
.mega__head{font-weight:700;color:var(--brand);text-decoration:none;display:block;padding:.35rem 0}
.mega__cols a{text-decoration:none}
.mega__cols a:hover,.nav a:hover{color:var(--accent)}
.mega__sub a{display:block;padding:.3rem 0;color:var(--muted)}
.mega__all{display:inline-block;margin-top:.75rem;color:var(--teal);font-weight:700}
@media (min-width:990px){
  .menu-toggle{display:none}
  .header__bar{flex-wrap:wrap}
  .nav,.nav[data-open]{display:block;position:static;width:100%;max-height:none;overflow:visible;border:0;padding:0 0 .4rem;order:3}
  .nav__top{display:flex;flex-wrap:wrap;gap:.1rem 1.1rem;justify-content:center}
  .nav__top>li{border:0}
  .nav__top>li>a,.nav__top summary{min-height:38px;font-size:.92rem}
  .nav summary::after{content:"\25BE";font-size:.8rem;margin-left:.3rem}
  .nav details[open]>summary::after{content:"\25B4"}
  .nav details[open]>summary{color:var(--accent)}
  .mega{position:absolute;left:0;right:0;top:100%;background:var(--paper);border-bottom:3px solid var(--sun);box-shadow:0 18px 30px rgba(0,0,0,.08);padding:1.5rem 0 2rem}
  .mega__cols{grid-template-columns:repeat(auto-fill,minmax(210px,1fr));gap:1.25rem 2rem}
}
/* Hero */
.hero{position:relative;display:grid;background:var(--brand);color:#fff;overflow:hidden}
.hero>*{grid-area:1/1}
.hero picture{display:block}
.hero__img{width:100%;height:100%;object-fit:cover;min-height:var(--hero-h-m)}
.hero__ph{min-height:var(--hero-h-m);background:linear-gradient(135deg,var(--brand),var(--accent) 55%,var(--sun));display:grid;place-items:center;color:rgba(255,255,255,.85);font-weight:700;text-align:center;padding:2rem}
.hero__content{align-self:end;padding:2rem 1rem;position:relative;max-width:var(--w);margin:0 auto;width:100%}
.hero--shade .hero__content{background:linear-gradient(transparent,rgba(0,0,0,.55))}
.hero--shade.hero--plain .hero__content{background:none}
.hero__content h1,.hero__content h2{text-shadow:0 2px 12px rgba(0,0,0,.35)}
.hero__btns{display:flex;flex-wrap:wrap;gap:.6rem;margin-top:1rem}
.hero .btn{background:var(--sun);border-color:var(--sun);color:var(--ink)}
.hero .btn--ghost{background:rgba(0,0,0,.25);border-color:#fff;color:#fff}
@media (max-width:749px){.hero--below-m{display:block}.hero--below-m .hero__content{background:var(--brand)!important}}
@media (min-width:750px){.hero__img,.hero__ph{min-height:var(--hero-h-d)}.hero__content{align-self:center;padding:3rem 1.5rem}.hero--shade .hero__content{background:none}.hero--shade::after{content:"";grid-area:1/1;background:linear-gradient(90deg,rgba(0,0,0,.5),transparent 70%)}.hero__content{z-index:1}}
/* Grids + cards */
.grid{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(2,1fr);gap:1.1rem .8rem}
@media (min-width:750px){.grid{grid-template-columns:repeat(3,1fr);gap:1.5rem 1.2rem}}
@media (min-width:990px){.grid--4{grid-template-columns:repeat(4,1fr)}}
.card__link{display:block;text-decoration:none}
.card__media{position:relative;aspect-ratio:1;background:var(--paper);border-radius:var(--radius);overflow:hidden;border:1px solid var(--line)}
.card__img{width:100%;height:100%;object-fit:contain}
.card__title{font-family:var(--font-body);font-weight:600;font-size:.95rem;margin:.55rem 0 .2rem;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.card__link:hover .card__title{color:var(--accent)}
.badge{position:absolute;top:.5rem;left:.5rem;padding:.15rem .6rem;border-radius:999px;font-size:.75rem;font-weight:700}
.badge--sale{background:var(--pink);color:#fff}
.badge--sold{background:var(--ink);color:#fff}
.price{display:flex;flex-wrap:wrap;gap:.4rem;align-items:baseline;font-weight:700}
.price--sale .price__now{color:#B3204A}
.price__was{color:var(--muted);font-weight:400;font-size:.9em}
.price__from{font-weight:400;color:var(--muted)}
.tiles{list-style:none;padding:0;margin:0;display:grid;grid-template-columns:repeat(2,1fr);gap:.8rem}
@media (min-width:750px){.tiles{grid-template-columns:repeat(4,1fr);gap:1.2rem}}
.tile a{display:block;text-decoration:none;background:var(--paper);border-radius:var(--radius);overflow:hidden;border:1px solid var(--line);height:100%}
.tile__media{aspect-ratio:1;background:var(--line)}
.tile__media img{width:100%;height:100%;object-fit:cover}
.tile__name{display:block;padding:.7rem .8rem;font-weight:700;font-family:var(--font-head)}
.tile:nth-child(4n+1) .tile__name{border-top:4px solid var(--accent)}
.tile:nth-child(4n+2) .tile__name{border-top:4px solid var(--teal)}
.tile:nth-child(4n+3) .tile__name{border-top:4px solid var(--sun)}
.tile:nth-child(4n+4) .tile__name{border-top:4px solid var(--pink)}
.section-head{display:flex;justify-content:space-between;align-items:baseline;gap:1rem;margin-bottom:1.2rem;flex-wrap:wrap}
.section-head a{color:var(--teal);font-weight:700}
/* Collection */
.coll-head{padding:1.5rem 0 .5rem}
.coll-head__desc{color:var(--muted);max-width:70ch}
.toolbar{display:flex;flex-wrap:wrap;gap:.6rem;align-items:center;justify-content:space-between;margin:1rem 0 1.4rem}
.facets{display:flex;flex-wrap:wrap;gap:.5rem;align-items:flex-start}
.facet{position:relative}
.facet>summary{list-style:none;cursor:pointer;border:1px solid var(--line);background:var(--paper);border-radius:999px;padding:.5rem 1rem;min-height:44px;display:flex;align-items:center}
.facet>summary::-webkit-details-marker{display:none}
.facet__panel{position:absolute;z-index:5;top:110%;left:0;min-width:240px;max-height:320px;overflow:auto;background:var(--paper);border:1px solid var(--line);border-radius:var(--radius);padding:.8rem;box-shadow:0 10px 25px rgba(0,0,0,.1)}
.facet__panel label{display:flex;gap:.5rem;align-items:center;padding:.3rem 0;cursor:pointer}
.facet__price{display:flex;gap:.5rem}
.sort{display:flex;gap:.5rem;align-items:center}
.sort select{min-height:44px;border:1px solid var(--line);border-radius:999px;padding:0 1rem;background:var(--paper)}
.active-filters{display:flex;flex-wrap:wrap;gap:.4rem;margin-bottom:1rem}
.chip{border:1px solid var(--line);border-radius:999px;padding:.3rem .8rem;text-decoration:none;font-size:.85rem;background:var(--paper)}
.pagination{display:flex;justify-content:center;gap:.4rem;margin:2.5rem 0 0;flex-wrap:wrap}
.pagination a,.pagination span{min-width:44px;min-height:44px;display:inline-flex;align-items:center;justify-content:center;border-radius:999px;text-decoration:none}
.pagination .current{background:var(--brand);color:#fff}
.empty{padding:3rem 0;text-align:center;color:var(--muted)}
/* Product */
.breadcrumbs{font-size:.85rem;color:var(--muted);padding:1rem 0 0}
.breadcrumbs a{text-decoration:none}
.product{display:grid;gap:1.5rem;padding-top:1rem}
@media (min-width:990px){.product{grid-template-columns:55% 1fr;gap:3rem;align-items:start}.product__info{position:sticky;top:120px}}
.gallery{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;gap:.5rem;margin:0 -1rem;padding:0 1rem;scrollbar-width:none}
.gallery::-webkit-scrollbar{display:none}
.gallery__item{flex:0 0 88%;scroll-snap-align:center;margin:0;background:var(--paper);border-radius:var(--radius);overflow:hidden;border:1px solid var(--line);aspect-ratio:1}
.gallery__item:only-child{flex-basis:100%}
.gallery__item img{width:100%;height:100%;object-fit:contain}
@media (min-width:990px){.gallery{display:grid;grid-template-columns:1fr 1fr;overflow:visible;margin:0;padding:0}.gallery__item{flex:none}.gallery__item:first-child{grid-column:1/-1}}
.thumbs{display:flex;gap:.4rem;overflow-x:auto;margin-top:.6rem;list-style:none;padding:0}
.thumbs a{display:block;width:60px;height:60px;border:1px solid var(--line);border-radius:8px;overflow:hidden;background:var(--paper)}
.thumbs img{width:100%;height:100%;object-fit:cover}
@media (min-width:990px){.thumbs{display:none}}
.product__title{margin-bottom:.3rem}
.product__vendor{color:var(--muted);font-size:.9rem;margin-bottom:.4rem}
.product .price{font-size:1.4rem;margin:.6rem 0 1rem}
.product-form{display:grid;gap:.8rem;margin:1rem 0}
.product-form label{font-weight:600;font-size:.9rem}
.qty{max-width:120px}
.mission-note{background:var(--paper);border-left:5px solid var(--accent);border-radius:var(--radius);padding:.9rem 1rem;margin:1.2rem 0;font-size:.95rem}
.product__desc{margin-top:1.2rem}
.meta-list{font-size:.88rem;color:var(--muted);list-style:none;padding:0}
/* Cart */
.cart-table{width:100%;border-collapse:collapse}
.cart-table td{padding:1rem .4rem;border-bottom:1px solid var(--line);vertical-align:top}
.cart-item__img{width:80px}
.cart-item__img img{border-radius:8px;background:var(--paper)}
.cart-foot{display:grid;gap:.8rem;justify-items:end;margin-top:1.5rem}
.cart-foot .btn{min-width:260px}
/* Text blocks */
.mission{background:var(--brand);color:#fff;text-align:center}
.mission .rte a{color:var(--sun)}
.mission__inner{max-width:760px;margin:0 auto}
.split{display:grid;gap:1.5rem;align-items:center}
@media (min-width:750px){.split{grid-template-columns:1fr 1fr;gap:3rem}.split--flip .split__media{order:2}}
.split__media img{border-radius:var(--radius);width:100%}
/* Meet the Team */
.team{display:grid;gap:1.5rem}
@media (min-width:750px){.team{grid-template-columns:repeat(var(--cols,3),1fr)}}
.member{background:var(--paper);border-radius:var(--radius);overflow:hidden;border:1px solid var(--line);display:flex;flex-direction:column}
.member__photo{aspect-ratio:4/5;background:var(--line)}
.member__photo img,.member__photo svg{width:100%;height:100%;object-fit:cover}
.member__body{padding:1.2rem}
.member__role{color:var(--accent);font-weight:700;margin-bottom:.6rem}
.member--memorial{border:3px solid var(--sun)}
.member__ribbon{background:var(--sun);color:var(--ink);font-weight:700;text-align:center;padding:.35rem;font-size:.9rem}
/* Footer */
.footer{background:var(--ink);color:#F3E8DA;padding:2.5rem 0 1.5rem;margin-top:3rem;font-size:.92rem}
.footer a{color:#F3E8DA;text-decoration:none}
.footer a:hover{color:var(--sun)}
.footer__cols{display:grid;gap:1.5rem}
@media (min-width:750px){.footer__cols{grid-template-columns:2fr 1fr 1fr}}
.footer h2{font-size:1.1rem;color:var(--sun)}
.footer ul{list-style:none;padding:0;margin:0}
.footer li{padding:.25rem 0}
.footer__bottom{border-top:1px solid rgba(255,255,255,.15);margin-top:2rem;padding-top:1rem;display:flex;flex-wrap:wrap;gap:1rem;justify-content:space-between;align-items:center}
.payments{display:flex;gap:.4rem;flex-wrap:wrap;list-style:none;padding:0;margin:0}
.payments svg{width:38px;height:24px}
.search-form{display:flex;gap:.5rem;max-width:560px}
.search-form .field{border-radius:999px}
.list-plain{list-style:none;padding:0}
</style>
