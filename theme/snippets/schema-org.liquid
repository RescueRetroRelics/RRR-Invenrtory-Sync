{%- comment -%} Structured data for Google. Product data comes from Shopify's own structured_data filter. {%- endcomment -%}
{%- if request.page_type == 'index' -%}
{%- assign search_target = request.origin | append: routes.search_url | append: '?q=' | append: '{' | append: 'search_term_string' | append: '}' -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "name": {{ shop.name | json }},
      "url": {{ request.origin | append: routes.root_url | json }}
      {%- if settings.org_description != blank -%},
      "description": {{ settings.org_description | json }}
      {%- endif -%}
      {%- if settings.org_email != blank -%},
      "email": {{ settings.org_email | json }}
      {%- endif -%}
      {%- if settings.logo != blank -%},
      "logo": {{ settings.logo | image_url: width: 600 | prepend: 'https:' | json }}
      {%- endif -%}
      {%- assign same_as = '' -%}
      {%- assign social_keys = 'social_facebook,social_instagram,social_tiktok,social_pinterest,social_youtube,social_x' | split: ',' -%}
      {%- for key in social_keys -%}
        {%- if settings[key] != blank -%}{%- assign same_as = same_as | append: settings[key] | append: '|' -%}{%- endif -%}
      {%- endfor -%}
      {%- if same_as != '' -%}
      {%- assign same_as_list = same_as | split: '|' -%},
      "sameAs": {{ same_as_list | json }}
      {%- endif %}
    },
    {
      "@type": "WebSite",
      "name": {{ shop.name | json }},
      "url": {{ request.origin | append: routes.root_url | json }},
      "potentialAction": {
        "@type": "SearchAction",
        "target": {{ search_target | json }},
        "query-input": "required name=search_term_string"
      }
    }
  ]
}
</script>
{%- elsif request.page_type == 'product' -%}
<script type="application/ld+json">{{ product | structured_data }}</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {"@type": "ListItem", "position": 1, "name": "Home", "item": {{ request.origin | append: routes.root_url | json }}},
    {%- if collection -%}
    {"@type": "ListItem", "position": 2, "name": {{ collection.title | json }}, "item": {{ request.origin | append: collection.url | json }}},
    {"@type": "ListItem", "position": 3, "name": {{ product.title | json }}, "item": {{ request.origin | append: product.url | json }}}
    {%- else -%}
    {"@type": "ListItem", "position": 2, "name": {{ product.title | json }}, "item": {{ request.origin | append: product.url | json }}}
    {%- endif -%}
  ]
}
</script>
{%- elsif request.page_type == 'collection' -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {"@type": "ListItem", "position": 1, "name": "Home", "item": {{ request.origin | append: routes.root_url | json }}},
    {"@type": "ListItem", "position": 2, "name": {{ collection.title | json }}, "item": {{ request.origin | append: collection.url | json }}}
  ]
}
</script>
{%- elsif request.page_type == 'article' -%}
<script type="application/ld+json">{{ article | structured_data }}</script>
{%- endif -%}
