{%- comment -%} Brand tokens + self-hosted brand fonts (only the fonts a page actually uses get downloaded). {%- endcomment -%}
{% style %}
  @font-face { font-family: "Luckiest Guy"; src: url({{ 'font-luckiest-guy.woff2' | asset_url }}) format("woff2"); font-display: swap; }
  @font-face { font-family: "Bangers"; src: url({{ 'font-bangers.woff2' | asset_url }}) format("woff2"); font-display: swap; }
  @font-face { font-family: "Pacifico"; src: url({{ 'font-pacifico.woff2' | asset_url }}) format("woff2"); font-display: swap; }
  {%- if settings.body_brand_font %}
  @font-face { font-family: "Playpen Sans"; src: url({{ 'font-playpen.woff2' | asset_url }}) format("woff2"); font-display: swap; }
  {%- endif %}
  :root {
    --font-display: "Luckiest Guy", "Arial Black", Impact, sans-serif;
    --font-label: "Bangers", "Arial Narrow", Impact, sans-serif;
    --font-script: "Pacifico", "Brush Script MT", cursive;
    --font-body: {% if settings.body_brand_font %}"Playpen Sans", {% endif %}-apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif;
    --color-bg: {{ settings.color_background }};
    --color-surface: {{ settings.color_surface }};
    --color-text: {{ settings.color_text }};
    --color-ink: #121212;
    --color-text-soft: {{ settings.color_text | color_mix: settings.color_background, 75 }};
    --color-primary: {{ settings.color_primary }};
    --color-primary-text: {{ settings.color_primary_text }};
    --color-teal: {{ settings.color_accent_1 }};
    --color-mustard: {{ settings.color_accent_2 }};
    --color-raspberry: {{ settings.color_accent_3 }};
    --color-mint: {{ settings.color_accent_4 }};
    --color-peach: #F5CB7E;
    --color-sale: {{ settings.color_sale }};
    --color-border: {{ settings.color_text | color_mix: settings.color_background, 18 }};
    --page-width: {{ settings.page_width }}px;
    --radius: {{ settings.corner_radius }}px;
    --logo-w: {{ settings.logo_width }}px;
  }
{% endstyle %}
