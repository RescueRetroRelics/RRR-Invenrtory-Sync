<div class="page-width section">
  <h1>{{ blog.title | escape }}</h1>
  {%- paginate blog.articles by 12 -%}
    <ul class="tiles">
      {%- for article in blog.articles -%}
        <li class="tile">
          <a href="{{ article.url }}">
            <div class="tile__media">
              {%- if article.image -%}
                {{ article.image | image_url: width: 600 | image_tag: loading: 'lazy', decoding: 'async', widths: '300,450,600', sizes: '(min-width: 750px) 23vw, 47vw', alt: article.title }}
              {%- else -%}
                {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder' }}
              {%- endif -%}
            </div>
            <span class="tile__name">{{ article.title | escape }}</span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
    {%- if paginate.pages > 1 -%}<nav class="pagination" aria-label="Pages">{{ paginate | default_pagination }}</nav>{%- endif -%}
  {%- endpaginate -%}
</div>

{% schema %}
{ "name": "Blog posts", "settings": [] }
{% endschema %}
