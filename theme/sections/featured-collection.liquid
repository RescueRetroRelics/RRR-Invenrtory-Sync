{%- assign col = section.settings.collection -%}
<section class="section page-width">
  <div class="section__head">
    <h2 class="section__title">{{ section.settings.heading | default: col.title }}</h2>
    {%- if col != blank -%}<a class="section__more" href="{{ col.url }}">View all &rarr;</a>{%- endif -%}
  </div>
  <div class="grid grid--products">
    {%- if col != blank and col.products_count > 0 -%}
      {%- for product in col.products limit: section.settings.limit -%}
        {%- render 'product-card', product: product -%}
      {%- endfor -%}
    {%- else -%}
      {%- for i in (1..4) -%}
        <div class="card">{%- render 'placeholder', class: 'media media--square', label: 'Pick a collection' -%}</div>
      {%- endfor -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Fresh finds" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "label": "Products to show", "min": 2, "max": 12, "step": 1, "default": 8 }
  ],
  "presets": [{ "name": "Featured collection" }]
}
{% endschema %}
