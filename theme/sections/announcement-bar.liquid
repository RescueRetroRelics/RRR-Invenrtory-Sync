{%- if section.settings.text != blank -%}
  <div class="announce" role="region" aria-label="Announcement">
    {%- if section.settings.link != blank -%}
      <a href="{{ section.settings.link }}">{{ section.settings.text | escape }}</a>
    {%- else -%}
      {{ section.settings.text | escape }}
    {%- endif -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "class": "section-announce",
  "settings": [
    { "type": "text", "id": "text", "label": "Text", "default": "Shop Retro Collectibles, Save Shelter Dogs' Lives" },
    { "type": "url", "id": "link", "label": "Link (optional)" }
  ]
}
{% endschema %}
