{%- if section.settings.text != blank -%}
  <div class="announcement" style="--ann-bg: {{ section.settings.background }}; --ann-fg: {{ section.settings.text_color }}">
    <p class="page-width">
      {%- render 'icon', name: 'paw' -%}
      {%- if section.settings.link != blank -%}
        <a href="{{ section.settings.link }}">{{ section.settings.text }}</a>
      {%- else -%}
        {{ section.settings.text }}
      {%- endif -%}
    </p>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "class": "section-announcement",
  "settings": [
    { "type": "text", "id": "text", "label": "Text", "default": "Every sale helps Detroit rescue dogs" },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "color", "id": "background", "label": "Background", "default": "#1A6866" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#FFFFFF" }
  ],
  "presets": [{ "name": "Announcement bar" }],
  "enabled_on": { "groups": ["header"] }
}
{% endschema %}
