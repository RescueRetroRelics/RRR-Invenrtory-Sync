<section class="section page-width rich-text rich-text--center password">
  <p class="header__shop-name">{%- render 'icon', name: 'paw' -%} {{ shop.name }}</p>
  <h1>Something good is coming</h1>
  {%- if shop.password_message != blank -%}<p>{{ shop.password_message }}</p>{%- endif -%}
  <details class="password__login">
    <summary>Store owner? Enter password</summary>
    {%- form 'storefront_password' -%}
      {{ form.errors | default_errors }}
      <label class="field"><span class="field__label">{{ 'general.password_page.login_form_password_label' | t }}</span>
        <input class="input" type="password" name="password" autocomplete="current-password">
      </label>
      <button class="button" type="submit">{{ 'general.password_page.login_password_button' | t }}</button>
    {%- endform -%}
  </details>
</section>
{% schema %}
{ "name": "Password", "settings": [] }
{% endschema %}
