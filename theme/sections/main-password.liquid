<div class="page-width section empty">
  <h1>{{ shop.name }}</h1>
  {%- if shop.password_message != blank -%}<p>{{ shop.password_message }}</p>{%- endif -%}
  {%- form 'storefront_password', class: 'search-form', style: 'margin:1rem auto' -%}
    {{ form.errors | default_errors }}
    <label class="visually-hidden" for="pw">Password</label>
    <input class="field" id="pw" type="password" name="password" placeholder="Password">
    <button class="btn" type="submit">Enter</button>
  {%- endform -%}
</div>

{% schema %}
{ "name": "Password", "settings": [] }
{% endschema %}
