<footer class="footer">
  <svg class="wave wave--top" viewBox="0 0 1440 60" preserveAspectRatio="none" aria-hidden="true"><path d="M0 30c120 25 240 25 360 0s240-25 360 0 240 25 360 0 240-25 360 0v30H0Z"/></svg>
  <div class="footer__inner page-width">
    <div class="footer__mission">
      <p class="footer__brand">{%- render 'icon', name: 'paw' -%} {{ shop.name }}</p>
      <p>{{ settings.mission_statement }}</p>
      {%- if section.settings.tagline != blank -%}<p class="footer__tagline">{%- render 'icon', name: 'shamrock' -%} {{ section.settings.tagline }}</p>{%- endif -%}
      <ul class="footer__social" aria-label="Follow us">
        {%- if settings.social_facebook != blank -%}<li><a href="{{ settings.social_facebook }}" aria-label="Facebook">{% render 'icon', name: 'facebook' %}</a></li>{%- endif -%}
        {%- if settings.social_instagram != blank -%}<li><a href="{{ settings.social_instagram }}" aria-label="Instagram">{% render 'icon', name: 'instagram' %}</a></li>{%- endif -%}
        {%- if settings.social_tiktok != blank -%}<li><a href="{{ settings.social_tiktok }}" aria-label="TikTok">{% render 'icon', name: 'tiktok' %}</a></li>{%- endif -%}
        {%- if settings.social_pinterest != blank -%}<li><a href="{{ settings.social_pinterest }}" aria-label="Pinterest">{% render 'icon', name: 'pinterest' %}</a></li>{%- endif -%}
        {%- if settings.social_ebay != blank -%}<li><a href="{{ settings.social_ebay }}" aria-label="eBay store">{% render 'icon', name: 'ebay' %}</a></li>{%- endif -%}
      </ul>
    </div>
    {%- if section.settings.show_policies and shop.policies.size > 0 -%}
      <div class="footer__col">
        <p class="footer__heading">{{ section.settings.policies_heading }}</p>
        <ul>
          {%- for policy in shop.policies -%}<li><a href="{{ policy.url }}">{{ policy.title }}</a></li>{%- endfor -%}
        </ul>
      </div>
    {%- endif -%}
    {%- for block in section.blocks -%}
      {%- assign menu = linklists[block.settings.menu] -%}
      <div class="footer__col" {{ block.shopify_attributes }}>
        <p class="footer__heading">{{ block.settings.heading | default: menu.title }}</p>
        <ul>
          {%- for link in menu.links -%}
            <li><a href="{{ link.url }}">{{ link.title }}</a></li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endfor -%}
  </div>
  <div class="footer__bottom page-width">
    <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ section.settings.small_print }}</p>
    {%- if section.settings.show_payment_icons -%}
      <ul class="footer__payments" aria-label="Payment methods">
        {%- for type in shop.enabled_payment_types -%}
          <li>{{ type | payment_type_svg_tag: class: 'payment-icon' }}</li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "class": "section-footer",
  "settings": [
    { "type": "text", "id": "tagline", "label": "Tagline", "default": "Irish roots. Michigan heart. Rescue soul." },
    { "type": "text", "id": "small_print", "label": "Small print", "default": "Rescued relics. Rescued dogs." },
    { "type": "checkbox", "id": "show_policies", "label": "Show policy links (from Settings > Policies)", "default": true },
    { "type": "text", "id": "policies_heading", "label": "Policies heading", "default": "The fine print" },
    { "type": "checkbox", "id": "show_payment_icons", "label": "Show payment icons", "default": true }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu column",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    }
  ],
  "enabled_on": { "groups": ["footer"] }
}
{% endschema %}
