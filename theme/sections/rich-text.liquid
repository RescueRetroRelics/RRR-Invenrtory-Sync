<section class="section page-width rich-text rich-text--{{ section.settings.align }} rich-text--{{ section.settings.style }}">
  <div class="rich-text__inner">
    {%- if section.settings.style == 'quote' -%}{%- render 'icon', name: 'paw' -%}{%- endif -%}
    {%- if section.settings.heading != blank -%}<h2 class="display">{{ section.settings.heading }}</h2>{%- endif -%}
    <div class="rte">{{ section.settings.text }}</div>
  </div>
</section>

{% schema %}
{
  "name": "Rich text",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Saving one dog won't fix the problem." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>But it means the world to that one dog. Every order you place helps fund transport runs, medical bills and fosters for Detroit rescue dogs.</p>" },
    { "type": "select", "id": "style", "label": "Style", "default": "plain", "options": [
      { "value": "plain", "label": "Plain" }, { "value": "story", "label": "Story card" }, { "value": "quote", "label": "Big quote" }
    ] },
    { "type": "select", "id": "align", "label": "Alignment", "default": "center", "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }] }
  ],
  "presets": [{ "name": "Rich text" }]
}
{% endschema %}
