[
  {
    "name": "theme_info",
    "theme_name": "RRR Relic",
    "theme_version": "0.1.0",
    "theme_author": "Rescue Retro Relics",
    "theme_documentation_url": "https://github.com/RescueRetroRelics/RRR-Invenrtory-Sync",
    "theme_support_url": "https://rescueretrorelics.com"
  },
  {
    "name": "Brand",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo"
      },
      {
        "type": "range",
        "id": "logo_width",
        "label": "Logo width",
        "min": 40,
        "max": 200,
        "step": 10,
        "unit": "px",
        "default": 72
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon",
        "info": "32 x 32px PNG"
      },
      {
        "type": "textarea",
        "id": "mission_statement",
        "label": "Mission statement",
        "default": "Retro-inspired collectibles with a purpose. Every sale helps Detroit rescue dogs."
      }
    ]
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "color",
        "id": "color_background",
        "label": "Background (cream)",
        "default": "#F6EBD3"
      },
      {
        "type": "color",
        "id": "color_surface",
        "label": "Cards / panels",
        "default": "#FFFBF2"
      },
      {
        "type": "color",
        "id": "color_text",
        "label": "Text (charcoal)",
        "default": "#2B3A3A"
      },
      {
        "type": "color",
        "id": "color_primary",
        "label": "Primary (retro orange)",
        "default": "#EB540A"
      },
      {
        "type": "color",
        "id": "color_primary_text",
        "label": "Text on primary",
        "default": "#121212"
      },
      {
        "type": "color",
        "id": "color_accent_1",
        "label": "Teal",
        "default": "#0D6E77"
      },
      {
        "type": "color",
        "id": "color_accent_2",
        "label": "Mustard",
        "default": "#DEBB07"
      },
      {
        "type": "color",
        "id": "color_accent_3",
        "label": "Raspberry",
        "default": "#A03D5E"
      },
      {
        "type": "color",
        "id": "color_accent_4",
        "label": "Mint",
        "default": "#79E2CC"
      },
      {
        "type": "color",
        "id": "color_sale",
        "label": "Sale price (red)",
        "default": "#C8392B"
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "paragraph",
        "content": "Brand fonts: Luckiest Guy (headings), Bangers (labels), Pacifico (script accents), Playpen Sans (body). They ship inside the theme, so there's no outside font service."
      },
      {
        "type": "checkbox",
        "id": "body_brand_font",
        "label": "Use Playpen Sans for body text",
        "info": "Turn off to use each visitor's built-in font (slightly faster).",
        "default": true
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "range",
        "id": "page_width",
        "label": "Page width",
        "min": 1000,
        "max": 1600,
        "step": 20,
        "unit": "px",
        "default": 1280
      },
      {
        "type": "range",
        "id": "corner_radius",
        "label": "Corner radius",
        "min": 0,
        "max": 24,
        "step": 2,
        "unit": "px",
        "default": 12
      }
    ]
  },
  {
    "name": "Product cards",
    "settings": [
      {
        "type": "select",
        "id": "card_image_ratio",
        "label": "Image shape",
        "default": "square",
        "options": [
          {
            "value": "square",
            "label": "Square"
          },
          {
            "value": "portrait",
            "label": "Portrait"
          },
          {
            "value": "natural",
            "label": "Natural"
          }
        ]
      },
      {
        "type": "checkbox",
        "id": "card_show_vendor",
        "label": "Show vendor",
        "default": false
      }
    ]
  },
  {
    "name": "Social media",
    "settings": [
      {
        "type": "url",
        "id": "social_facebook",
        "label": "Facebook"
      },
      {
        "type": "url",
        "id": "social_instagram",
        "label": "Instagram"
      },
      {
        "type": "url",
        "id": "social_tiktok",
        "label": "TikTok"
      },
      {
        "type": "url",
        "id": "social_ebay",
        "label": "eBay store"
      },
      {
        "type": "url",
        "id": "social_pinterest",
        "label": "Pinterest"
      }
    ]
  }
]